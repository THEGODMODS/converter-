{
  "name": "thegodmods-face-forge",
  "version": "0.2.0",
  "private": true,
  "description": "PES 2021 to PES 2017 face converter with interactive 3D preview by KFC GODMODS",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "dist:win": "npm run build && npm run build:icon && npm run build:native && electron-builder --win nsis --publish never",
    "predev": "npm run build:electron && npm run build:native",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:icon": "node scripts/build-icon.mjs",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "^9.1.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wait-on": "^8.0.1",
    "sharp": "^0.35.5",
    "png-to-ico": "^3.0.1",
    "@types/three": "^0.180.0"
  },
  "build": {
    "appId": "com.thegodmods.faceforge",
    "productName": "KFC GODMODS FACE FORGE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/face-forge.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "KFC-GODMODS-FACE-FORGE-${version}-Setup.${ext}",
    "extraResources": [
      {
        "from": "assets/face-forge.ico",
        "to": "face-forge.ico"
      },
      {
        "from": "native/target/release/face-forge-native.exe",
        "to": "face-forge-native.exe"
      }
    ],
    "copyright": "Copyright © 2026 KFC GODMODS"
  },
  "author": "KFC GODMODS"
}
